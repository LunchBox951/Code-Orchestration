{
  "name": "code-orchestration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -b && node apps/desktop/scripts/copy-renderer-assets.mjs",
    "typecheck": "tsc -b && pnpm typecheck:test",
    "typecheck:test": "tsc -p packages/core/tsconfig.test.json && tsc -p packages/cli/tsconfig.test.json && tsc -p packages/mcp/tsconfig.test.json && tsc -p apps/desktop/tsconfig.test.json && tsc -p apps/desktop/tsconfig.renderer.test.json",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:live": "pnpm build",
    "test:live": "CO_LIVE_E2E=1 vitest run packages/mcp/src/conductor/worker-benchmark.live.test.ts packages/mcp/src/conductor/orchestration-benchmark.live.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
