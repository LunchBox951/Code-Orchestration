{
  "name": "code-orchestration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -b && node apps/desktop/scripts/copy-renderer-assets.mjs",
    "typecheck": "tsc -b && pnpm typecheck:test",
    "typecheck:test": "tsc -p packages/core/tsconfig.test.json && tsc -p packages/cli/tsconfig.test.json && tsc -p packages/mcp/tsconfig.test.json && tsc -p apps/desktop/tsconfig.test.json && tsc -p apps/desktop/tsconfig.renderer.test.json",
    "pretest": "pnpm build",
    "test": "vitest run --exclude \".co/**\"",
    "test:watch": "vitest --exclude \".co/**\"",
    "pretest:live": "pnpm build",
    "test:live": "CO_LIVE_E2E=1 vitest run --exclude \".co/**\" packages/mcp/src/conductor/worker-benchmark.live.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "hono": "^4.12.25",
      "undici": "^6.27.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
